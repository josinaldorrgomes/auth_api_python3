# Copie este arquivo para ".env" e preencha. NUNCA faça commit do .env (já está no .gitignore).
# Gere cada segredo com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=troque-por-um-segredo-aleatorio
AUTH_OTP_PEPPER=troque-por-outro-segredo-aleatorio

# Canal de entrega do código MFA: console | telegram_gateway | email
AUTH_MFA_CHANNEL=console

# --- Opção A: Telegram Gateway (código chega no Telegram do SEU número; grátis p/ o próprio número)
# AUTH_MFA_CHANNEL=telegram_gateway
# AUTH_TELEGRAM_GATEWAY_TOKEN=cole-aqui-o-token-de-gateway.telegram.org

# --- Opção B: E-mail pelo Gmail (exige verificação em 2 etapas + senha de app)
# AUTH_MFA_CHANNEL=email
# AUTH_SMTP_HOST=smtp.gmail.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=seu.email@gmail.com
# AUTH_SMTP_PASSWORD=senha-de-app-de-16-letras
# AUTH_SMTP_SENDER=seu.email@gmail.com

# --- Opção C: E-mail pelo Brevo (plano gratuito: 300 e-mails/dia)
# AUTH_MFA_CHANNEL=email
# AUTH_SMTP_HOST=smtp-relay.brevo.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=login-smtp-mostrado-no-painel-do-brevo
# AUTH_SMTP_PASSWORD=chave-smtp-do-brevo
# AUTH_SMTP_SENDER=remetente-verificado@seudominio.com
